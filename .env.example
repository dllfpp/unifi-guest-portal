# Optional: the setup wizard asks for all of this on the first start and saves it in /data/config.json.
# Values set here (environment variables) take precedence over that file.

# --- UniFi controller (required) ---
# UniFi OS gateway/console (UCG Fiber, UDM, Cloud Key): https://<gateway> (port 443)
# UniFi OS Server: https://<host>:11443   self-hosted Network Application: https://<host>:8443
UNIFI_URL=https://unifi.example.lan:8443
# Local admin account (not a UI.com account), without two-factor authentication, able to manage the Network app
UNIFI_USER=guest-portal
UNIFI_PASS=
# Short site name, the one in the controller URLs (/manage/<site>/...): usually "default"
UNIFI_SITE=default

# --- Guest network (required) ---
# Must match the WiFi network name exactly: redirects from other networks are refused
SSID=GUEST-WIFI

# --- Telegram (a DEDICATED bot: nothing else may read its updates, or the buttons hit 409 Conflict) ---
TG_TOKEN=
# Private chat id, or group id (the bot must be an admin of the group)
TG_CHAT=
# Owner: always allowed to press the buttons; gets the requests in private until the topic is known
TG_ADMIN=
# Group with topics: topic name (learned from the first message written there) or its id directly
TG_TOPIC=
TG_THREAD=
# Language of the Telegram messages for the owner: en (default) or it.
# Guest pages follow the browser: Italian if it prefers Italian, English otherwise.
TG_LANG=en

# --- Rules ---
# Access durations offered as buttons, in hours
DURATE=4,24
# A request with no answer expires after N minutes
SCADENZA_MIN=10
# After a rejection the same device must wait N minutes
PAUSA_RIFIUTO_MIN=15
# Maximum requests waiting at the same time
MAX_IN_ATTESA=5

# --- Admin panel on /admin (optional: without a password it is off) ---
# Plain password from the environment; the wizard saves an scrypt hash as ADMIN_HASH instead
ADMIN_PASS=
# Networks allowed to open the panel, comma separated (guest devices are always refused)
ADMIN_ALLOW=
